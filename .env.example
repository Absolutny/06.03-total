# Скопируйте в .env и задайте свои значения
ENVIRONMENT=development          # production — запрещает дефолтный JWT_SECRET
JWT_SECRET=                      # >= 32 символов: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
ADMIN_PASSWORD=                  # пароль первого администратора (иначе случайный — в логах при первом запуске)
SEED_DEMO_DATA=false             # true — тестовые аккаунты и занятия (только для разработки!)
CORS_ORIGINS=http://localhost:3000
